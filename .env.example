# Copy to .env.local. Every value is optional: without it the display falls
# back to the keyless providers and says so. Never commit .env.local.

# Server-only. Read by app/api/weather/route.ts; asked first for the weather
# card and the week strip (docs/DEPLOYMENT.md has the quota arithmetic).
GOOGLE_WEATHER_API_KEY=

# Server-only. Read by app/api/departures/route.ts for Rejseplanen API 2.0.
# Without it the route serves Transitous (docs/TRANSPORT.md).
REJSEPLANEN_ACCESS_ID=

# Server-only. Read by app/api/departures/route.ts to translate Danish service
# messages. Without it messages are shown untranslated.
DEEPL_API_KEY=

# Origin for social preview links in app/layout.tsx.
SITE_URL=http://localhost:3000
