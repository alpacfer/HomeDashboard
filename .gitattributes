# Normalize to LF in the repository so Ubuntu and macOS checkouts agree.
* text=auto eol=lf

# Binary assets: never touch these.
*.ttf   binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary

# Generated. Collapse in diffs and exclude from language stats. The list
# matches "Do not touch without being asked" in AGENTS.md.
package-lock.json      linguist-generated=true -diff
public/facts/daily/*   linguist-generated=true -diff
app/clock-fonts.css    linguist-generated=true
app/horizon.css        linguist-generated=true
